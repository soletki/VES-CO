<Window x:Class="VESCO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VESCO"
        mc:Ignorable="d"
        Title="VESCO - Video Editor" Height="900" Width="1600"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="White">
            <MenuItem Header="File" Foreground="White">
                <MenuItem Header="Import Media" Click="OpenVideo_Click" Foreground="#2D2D30"/>
                <MenuItem Header="Export Media" Click="ExportVideoClick" Foreground="#2D2D30"/>
                <Separator/>
                <MenuItem Header="Exit" Foreground="#2D2D30"/>
            </MenuItem>
            <MenuItem Header="Sequence" Foreground="White">
                <MenuItem Header="Add Track" Click="AddTrackClick" Foreground="#2D2D30"/>
            </MenuItem>
            <MenuItem Header="Window" Foreground="White">
                <MenuItem Header="Reset Workspace" Foreground="#2D2D30"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#555"/>

            <!-- Top Half -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" Background="#555"/>

                <!-- Effect Controls Panel (Top Left) -->
                <Border Grid.Column="0" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#2D2D30" Padding="8">
                            <TextBlock Text="Effect Controls" Foreground="White" FontWeight="Bold"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Position -->
                                <TextBlock Text="X" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="-1000" Maximum="1000" Value="0" 
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Name="XTextBox"  Grid.Column="1" Text="0.0" Background="#3F3F46" 
                                             Foreground="White" BorderBrush="#555" Padding="5" KeyDown="XTextBoxKeyDown"/>
                                </Grid>

                                <TextBlock Text="Y" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="-1000" Maximum="1000" Value="0" 
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Name="YTextBox" Grid.Column="1" Text="0.0" Background="#3F3F46" 
                                        Foreground="White" BorderBrush="#555" Padding="5" KeyDown="YTextBoxKeyDown"/>
                                </Grid>

                                <!-- Scale -->
                                <TextBlock Text="Scale" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="200" Value="100" 
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Name="ScaleTextBox" Grid.Column="1" Text="100.0" Background="#3F3F46" 
                                             Foreground="White" BorderBrush="#555" Padding="5" KeyDown="ScaleTextBoxKeyDown"/>
                                </Grid>

                                <!-- Opacity -->
                                <TextBlock Text="Opacity" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="100" 
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Name="OpacityTextBox" Grid.Column="1" Text="100.0" Background="#3F3F46" 
                                             Foreground="White" BorderBrush="#555" Padding="5" KeyDown="OpacityTextBoxKeyDown"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Program Monitor (Top Right) -->
                <Border Grid.Column="2" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="#2D2D30" Padding="8">
                            <DockPanel>
                                <TextBlock Text="Preview" Foreground="White" FontWeight="Bold"/>
                                <ComboBox x:Name="PreviewScaleDropdown" Width="80" HorizontalAlignment="Right"
                                          Background="#3F3F46" Foreground="#2D2D30" BorderBrush="#555"
                                          SelectionChanged="OnPreviewScaleChanged" SelectedIndex="1">
                                    <ComboBoxItem Content="Full"/>
                                    <ComboBoxItem Content="1/2"/>
                                    <ComboBoxItem Content="1/4"/>
                                    <ComboBoxItem Content="1/8"/>
                                </ComboBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#111">
                            <Image x:Name="previewImage" Stretch="Uniform"/>
                        </Border>

                        <Border Grid.Row="2" Background="#2D2D30" Padding="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⏮" Width="32" Height="28" Margin="2" Click="SeekStartClick" 
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="◄" Width="32" Height="28" Margin="2"
                                        Name="FrameBack" Click="FrameBackClick"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="▶" Width="40" Height="28" Margin="5,2"
                                        Name="PlayPause" Click="PlayPauseClick"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="►" Width="32" Height="28" Margin="2"
                                        Name="FrameForward" Click="FrameForwardClick"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="⏭" Width="32" Height="28" Margin="2" Click="SeekEndClick"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <TextBlock x:Name="TimecodeDisplay" Text="00:00:00:00" 
                                          VerticalAlignment="Center" Foreground="White" 
                                          Margin="15,0,0,0" FontFamily="Consolas" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Half -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" Background="#555"/>

                <!-- Project Files Panel (Bottom Left) -->
                <Border Grid.Column="0" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#2D2D30" Padding="8">
                            <DockPanel>
                                <TextBlock Text="Project Files" Foreground="White" FontWeight="Bold"/>
                                <Button Click="OpenVideo_Click" Content="Import" Width="60" Height="25"
                                        DockPanel.Dock="Right" Background="#3F3F46" 
                                        Foreground="White" BorderBrush="#555"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                            <ListBox x:Name="MediaBinList"
                                     ItemsSource="{Binding MediaBin}"
                                     PreviewMouseLeftButtonDown="MediaBinMouseDown"
                                     Background="#232323"
                                     Foreground="White"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" 
                                                   Foreground="White" Padding="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>

                <!-- Timeline Panel (Bottom Right) -->
                <Border Grid.Column="2" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Background="#2D2D30" Padding="6">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Name="SelectTool" BorderBrush="#555" BorderThickness="1" 
                                            Margin="2" Background="#3F3F46" Padding="5"
                                            MouseLeftButtonDown="SelectToolClick" Cursor="Hand">
                                        <TextBlock Text="⬌" Foreground="White" FontSize="14"/>
                                    </Border>
                                    <Border Name="CutTool" BorderBrush="#555" BorderThickness="1" 
                                            Margin="2" Background="#3F3F46" Padding="5"
                                            MouseLeftButtonDown="CutToolClick" Cursor="Hand">
                                        <TextBlock Text="✂" Foreground="White" FontSize="14"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="FrameCounter" Text="0 / 0" 
                                          VerticalAlignment="Center" Foreground="White"
                                          HorizontalAlignment="Right" FontFamily="Consolas"
                                          Margin="10,0"/>
                            </DockPanel>
                        </Border>

                        <!-- Timeline Area -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Track Labels -->
                            <Border Grid.Column="0" Background="#1E1E1E" 
                                    BorderBrush="#3F3F46" BorderThickness="0,0,0,0" Panel.ZIndex="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="1"
                                                  x:Name="LabelsScrollViewer"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="TrackLabelsPanel" Background="#1E1E1E" 
                                                    VerticalAlignment="Top"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Timeline Tracks -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Fixed Ruler at top with playhead -->
                                <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#3F3F46" 
                                        BorderThickness="0,1,0,1" Height="25" Panel.ZIndex="1">
                                    <Grid>
                                        <Canvas x:Name="PlayheadRulerCanvas" 
                                            Background="Transparent"
                                            Panel.ZIndex="1">
                                            <Canvas x:Name="PlayheadCanvas">
                                                <Polygon x:Name="PlayheadTop" 
                                                     Fill="#FF4A9EFF"
                                                     Points="-4,0 4,0 4,6 0,10 -4,6"
                                                     Canvas.Left="1"/>
                                                <Rectangle x:Name="Playhead"
                                                   Width="2"
                                                   Height="2000"
                                                   Fill="#FF4A9EFF"/>
                                            </Canvas>
                                        </Canvas>
                                        <ScrollViewer x:Name="RulerScrollViewer"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <Canvas Background="#1A1A1A" Width="3000" Height="25"/>
                                        </ScrollViewer>

                                        <!-- Playhead overlay on ruler -->
                                        
                                    </Grid>
                                </Border>

                                <!-- Timeline ScrollViewer -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timeline Canvas -->
                                    <ScrollViewer Grid.Column="1"
                                                  x:Name="TimelineScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  ScrollChanged="TimelineScrollChanged"
                                                  Background="#111">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollViewer">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollViewer">
                                                            <Grid>
                                                                <ScrollContentPresenter />
                                                                <ScrollBar Name="PART_VerticalScrollBar"
                                                                           Value="{TemplateBinding VerticalOffset}"
                                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                                           HorizontalAlignment="Right"
                                                                           Width="12"
                                                                           Opacity="0.7"/>
                                                                <ScrollBar Name="PART_HorizontalScrollBar"
                                                                           Orientation="Horizontal"
                                                                           Value="{TemplateBinding HorizontalOffset}"
                                                                           Maximum="{TemplateBinding ScrollableWidth}"
                                                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                                           VerticalAlignment="Bottom"
                                                                           Height="12"
                                                                           Opacity="0.7"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <Grid>
                                            
                                            
                                            <Canvas x:Name="TimelineArea"
                                                Width="3000"
                                                Background="#111"
                                                MouseLeftButtonDown="TimelineClick"
                                                MouseMove="TimelineMove"
                                                MouseLeftButtonUp="TimelineRelease"
                                                AllowDrop="True"
                                                Drop="TimelineDrop"
                                                VerticalAlignment="Top"/>

                                        </Grid>
                                        
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>