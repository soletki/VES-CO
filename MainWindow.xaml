<Window x:Class="VESCO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VESCO"
        mc:Ignorable="d"
        Title="VESCO - Video Editor" Height="900" Width="1600"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="White">
            <MenuItem Header="File" Foreground="White">
                <MenuItem Header="New Project"/>
                <MenuItem Header="Open Project"/>
                <MenuItem Header="Save Project"/>
                <Separator/>
                <MenuItem Header="Import Media" Click="OpenVideo_Click"/>
                <Separator/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="Edit" Foreground="White">
                <MenuItem Header="Undo"/>
                <MenuItem Header="Redo"/>
                <Separator/>
                <MenuItem Header="Cut"/>
                <MenuItem Header="Copy"/>
                <MenuItem Header="Paste"/>
            </MenuItem>
            <MenuItem Header="Clip" Foreground="White">
                <MenuItem Header="Speed/Duration"/>
                <MenuItem Header="Audio Channels"/>
            </MenuItem>
            <MenuItem Header="Sequence" Foreground="White">
                <MenuItem Header="Add Track" Click="AddTrackClick"/>
            </MenuItem>
            <MenuItem Header="Window" Foreground="White">
                <MenuItem Header="Reset Workspace"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#555"/>

            <!-- Top Half -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" Background="#555"/>

                <!-- Effect Controls Panel (Top Left) -->
                <Border Grid.Column="0" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#2D2D30" Padding="8">
                            <TextBlock Text="Effect Controls" Foreground="White" FontWeight="Bold"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Position -->
                                <TextBlock Text="Position" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="-1000" Maximum="1000" Value="0" 
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Text="0.0" Background="#3F3F46" 
                                             Foreground="White" BorderBrush="#555" Padding="5"/>
                                </Grid>

                                <!-- Scale -->
                                <TextBlock Text="Scale" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="200" Value="100" 
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Text="100.0" Background="#3F3F46" 
                                             Foreground="White" BorderBrush="#555" Padding="5"/>
                                </Grid>

                                <!-- Opacity -->
                                <TextBlock Text="Opacity" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="100" 
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Text="100.0" Background="#3F3F46" 
                                             Foreground="White" BorderBrush="#555" Padding="5"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Program Monitor (Top Right) -->
                <Border Grid.Column="2" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="#2D2D30" Padding="8">
                            <DockPanel>
                                <TextBlock Text="Program Monitor" Foreground="White" FontWeight="Bold"/>
                                <ComboBox x:Name="PreviewScaleDropdown" Width="80" HorizontalAlignment="Right"
                                          Background="#3F3F46" Foreground="White" BorderBrush="#555"
                                          SelectedIndex="1">
                                    <ComboBoxItem Content="1/4"/>
                                    <ComboBoxItem Content="1/2"/>
                                    <ComboBoxItem Content="Full"/>
                                </ComboBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="Black" BorderBrush="Black" BorderThickness="2">
                            <Image x:Name="previewImage" Stretch="Uniform"/>
                        </Border>

                        <Border Grid.Row="2" Background="#2D2D30" Padding="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⏮" Width="32" Height="28" Margin="2" 
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="◄" Width="32" Height="28" Margin="2"
                                        Name="FrameBack" Click="FrameBackClick"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="▶" Width="40" Height="28" Margin="5,2"
                                        Name="PlayPause" Click="PlayPauseClick"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="►" Width="32" Height="28" Margin="2"
                                        Name="FrameForward" Click="FrameForwardClick"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <Button Content="⏭" Width="32" Height="28" Margin="2"
                                        Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
                                <TextBlock x:Name="TimecodeDisplay" Text="00:00:00:00" 
                                          VerticalAlignment="Center" Foreground="White" 
                                          Margin="15,0,0,0" FontFamily="Consolas" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Half -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" Background="#555"/>

                <!-- Project Files Panel (Bottom Left) -->
                <Border Grid.Column="0" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#2D2D30" Padding="8">
                            <DockPanel>
                                <TextBlock Text="Project Files" Foreground="White" FontWeight="Bold"/>
                                <Button Click="OpenVideo_Click" Content="Import" Width="60" Height="25"
                                        DockPanel.Dock="Right" Background="#3F3F46" 
                                        Foreground="White" BorderBrush="#555"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                            <ListBox x:Name="MediaBinList"
                                     ItemsSource="{Binding MediaBin}"
                                     PreviewMouseLeftButtonDown="MediaBinMouseDown"
                                     Background="#232323"
                                     Foreground="White"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" 
                                                   Foreground="White" Padding="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>

                <!-- Timeline Panel (Bottom Right) -->
                <Border Grid.Column="2" Background="#232323" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Background="#2D2D30" Padding="6">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Name="SelectTool" BorderBrush="#555" BorderThickness="1" 
                                            Margin="2" Background="#3F3F46" Padding="5"
                                            MouseLeftButtonDown="SelectToolClick" Cursor="Hand">
                                        <TextBlock Text="⬌" Foreground="White" FontSize="14"/>
                                    </Border>
                                    <Border Name="CutTool" BorderBrush="#555" BorderThickness="1" 
                                            Margin="2" Background="#3F3F46" Padding="5"
                                            MouseLeftButtonDown="CutToolClick" Cursor="Hand">
                                        <TextBlock Text="✂" Foreground="White" FontSize="14"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="FrameCounter" Text="0 / 0" 
                                          VerticalAlignment="Center" Foreground="White"
                                          HorizontalAlignment="Right" FontFamily="Consolas"
                                          Margin="10,0"/>
                            </DockPanel>
                        </Border>

                        <!-- Timeline Ruler -->
                        <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#3F3F46" 
                                BorderThickness="0,1,0,1" Height="25">
                            <Canvas x:Name="TimelineRuler" Background="#1A1A1A"/>
                        </Border>

                        <!-- Timeline Area -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Track Labels -->
                            <Border Grid.Column="0" Background="#1E1E1E" 
                                    BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                                <ScrollViewer x:Name="LabelsScrollViewer"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TrackLabelsPanel" Background="#1E1E1E"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Timeline Tracks -->
                            <ScrollViewer Grid.Column="1"
                                          x:Name="TimelineScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="TimelineScrollChanged"
                                          Background="#111">
                                <Canvas x:Name="TimelineArea"
                                        Width="3000"
                                        MinHeight="200"
                                        Background="#111"
                                        MouseLeftButtonDown="TimelineClick"
                                        MouseMove="TimelineMove"
                                        MouseLeftButtonUp="TimelineRelease"
                                        AllowDrop="True"
                                        Drop="TimelineDrop">

                                    <!-- Playhead -->
                                    <Canvas x:Name="PlayheadCanvas" Panel.ZIndex="100">
                                        <Polygon x:Name="PlayheadTop" 
                                                 Fill="#FF4A9EFF"
                                                 Points="0,0 8,0 8,6 4,10 0,6"/>
                                        <Rectangle x:Name="Playhead"
                                                   Width="2"
                                                   Fill="#FF4A9EFF"/>
                                    </Canvas>
                                </Canvas>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>