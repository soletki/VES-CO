<Window x:Class="VESCO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VESCO"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>


        <Border Grid.Row="0" Grid.Column="1" Background="Black"
                BorderBrush="Black" BorderThickness="2">
            <Image Grid.Row="1" Grid.Column="1" x:Name="previewImage" ></Image>
        </Border>


        <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="#666" Height="30" Padding="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <DockPanel>
                    <TextBlock Text="import media"
                               VerticalAlignment="Center"
                               Foreground="White"/>
                    <Button Click="OpenVideo_Click" Content="+" Width="25" Height="25"
                            DockPanel.Dock="Right" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" BorderBrush="Black"
                    BorderThickness="2">
                <ListBox x:Name="MediaBinList"
                     Grid.Row="1"
                     Margin="0,5,0,0"
                     ItemsSource="{Binding MediaBin}"
                     PreviewMouseLeftButtonDown="MediaBinMouseDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#333"
                                Margin="4"
                                Padding="6"
                                CornerRadius="4">
                                <TextBlock Text="{Binding FileName}"
                                    Foreground="White"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#2D2D30" Padding="6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Content="⏮" Width="32" Margin="2"
                            Name="FrameBack"
                            Click="FrameBackClick"/>
                    <Button Content="⏭" Width="32" Margin="2"
                            Name="FrameForward"
                            Click="FrameForwardClick"/>
                    <Button Content="▶" Width="32" Margin="6,2,2,2"
                            Name="PlayPause"
                            Click="PlayPauseClick"/>

                    <Separator Width="12"/>

                    <Button Content="✋" Margin="2"/>
                    <Button Content="✂" Margin="2" Name="CutTool" Click="CutToolClick"/>
                    <Button Content="⬌" Margin="2" Name="SelectTool" Click="SelectToolClick"/>

                    <Separator Width="12"/>

                    <Button Content="+ Track" Margin="2" Click="AddTrackClick"/>

                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Background="Black">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Background="#1E1E1E"
                        BorderBrush="Black" 
                        BorderThickness="0,0,1,0">
                    <ScrollViewer x:Name="LabelsScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TrackLabelsPanel"
                                   Background="#1E1E1E"
                                   MinHeight="200">
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <ScrollViewer Grid.Column="1"
                              x:Name="TimelineScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="TimelineScrollChanged">
                    <Canvas x:Name="TimelineArea"
                            Width="3000"
                            MinHeight="200"
                            Background="#111"
                            MouseLeftButtonDown="TimelineClick"
                            MouseMove="TimelineMove"
                            MouseLeftButtonUp="TimelineRelease"
                            AllowDrop="True"
                            Drop="TimelineDrop">

                        <Rectangle x:Name="Playhead"
                                   Height="{Binding ActualHeight, ElementName=TimelineArea}"
                                   Width="3"
                                   Fill="Red"
                                   Panel.ZIndex="10"/>

                        <!-- Track containers will be added here dynamically -->
                    </Canvas>
                </ScrollViewer>
            </Grid>
        </Grid>


    </Grid>
</Window>