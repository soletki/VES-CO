<Window x:Class="VESCO.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Video" 
        Height="550" 
        Width="500"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Export Settings" 
                   Foreground="White" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Settings Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Output File -->
                <TextBlock Text="Output File" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathTextBox" 
                             Grid.Column="0"
                             Background="#3F3F46" 
                             Foreground="White" 
                             BorderBrush="#555" 
                             Padding="8"
                             IsReadOnly="True"/>
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Width="80" 
                            Height="32"
                            Margin="5,0,0,0"
                            Background="#3F3F46" 
                            Foreground="White" 
                            BorderBrush="#555"
                            Click="BrowseOutputPath_Click"/>
                </Grid>

                <!-- Resolution -->
                <TextBlock Text="Resolution" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="ResolutionComboBox" 
                          Background="#3F3F46" 
                          Foreground="White" 
                          BorderBrush="#555"
                          Padding="8"
                          Margin="0,0,0,15"
                          SelectedIndex="2">
                    <ComboBoxItem Content="3840 x 2160 (4K UHD)" Tag="3840x2160"/>
                    <ComboBoxItem Content="2560 x 1440 (1440p)" Tag="2560x1440"/>
                    <ComboBoxItem Content="1920 x 1080 (1080p)" Tag="1920x1080"/>
                    <ComboBoxItem Content="1280 x 720 (720p)" Tag="1280x720"/>
                    <ComboBoxItem Content="854 x 480 (480p)" Tag="854x480"/>
                    <ComboBoxItem Content="Custom" Tag="custom"/>
                </ComboBox>

                <!-- Custom Resolution (Hidden by default) -->
                <Grid x:Name="CustomResolutionPanel" Visibility="Collapsed" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomWidthTextBox" 
                             Grid.Column="0"
                             Background="#3F3F46" 
                             Foreground="White" 
                             BorderBrush="#555" 
                             Padding="8"
                             Text="1920"/>
                    <TextBlock Grid.Column="1" 
                               Text=" x " 
                               Foreground="White" 
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                    <TextBox x:Name="CustomHeightTextBox" 
                             Grid.Column="2"
                             Background="#3F3F46" 
                             Foreground="White" 
                             BorderBrush="#555" 
                             Padding="8"
                             Text="1080"/>
                </Grid>

                <!-- Frame Rate -->
                <TextBlock Text="Frame Rate (FPS)" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="FpsComboBox" 
                          Background="#3F3F46" 
                          Foreground="White" 
                          BorderBrush="#555"
                          Padding="8"
                          Margin="0,0,0,15"
                          SelectedIndex="1">
                    <ComboBoxItem Content="24 fps (Film)" Tag="24"/>
                    <ComboBoxItem Content="30 fps (Standard)" Tag="30"/>
                    <ComboBoxItem Content="60 fps (Smooth)" Tag="60"/>
                    <ComboBoxItem Content="120 fps (High Speed)" Tag="120"/>
                    <ComboBoxItem Content="Use Timeline FPS" Tag="timeline"/>
                </ComboBox>

                <!-- Codec -->
                <TextBlock Text="Video Codec" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CodecComboBox" 
                          Background="#3F3F46" 
                          Foreground="White" 
                          BorderBrush="#555"
                          Padding="8"
                          Margin="0,0,0,15"
                          SelectedIndex="0">
                    <ComboBoxItem Content="H.264 (MP4) - Best Compatibility" Tag="libx264"/>
                    <ComboBoxItem Content="H.265 (HEVC) - Smaller File Size" Tag="libx265"/>
                    <ComboBoxItem Content="VP9 (WebM) - Web Optimized" Tag="libvpx-vp9"/>
                    <ComboBoxItem Content="ProRes 422 - Professional" Tag="prores_ks"/>
                </ComboBox>

                <!-- Quality -->
                <TextBlock Text="Quality" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="QualitySlider" 
                            Grid.Column="0"
                            Minimum="0" 
                            Maximum="51" 
                            Value="18"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="QualitySlider_ValueChanged"/>
                    <TextBlock x:Name="QualityValueText" 
                               Grid.Column="1"
                               Text="18 (High)" 
                               Foreground="White" 
                               Width="80"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>
                <TextBlock Text="Lower values = better quality, larger file size" 
                           Foreground="#999" 
                           FontSize="11"
                           Margin="0,0,0,15"/>

                <!-- Pixel Format -->
                <TextBlock Text="Pixel Format" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="PixelFormatComboBox" 
                          Background="#3F3F46" 
                          Foreground="White" 
                          BorderBrush="#555"
                          Padding="8"
                          Margin="0,0,0,15"
                          SelectedIndex="0">
                    <ComboBoxItem Content="yuv420p (Standard)" Tag="yuv420p"/>
                    <ComboBoxItem Content="yuv422p (Better Quality)" Tag="yuv422p"/>
                    <ComboBoxItem Content="yuv444p (Maximum Quality)" Tag="yuv444p"/>
                </ComboBox>

                <!-- Progress Bar (Hidden by default) -->
                <Border x:Name="ProgressPanel" 
                        Visibility="Collapsed" 
                        Background="#2D2D30" 
                        Padding="10" 
                        CornerRadius="5"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ProgressText" 
                                   Text="Exporting: 0%" 
                                   Foreground="White" 
                                   Margin="0,0,0,5"/>
                        <ProgressBar x:Name="ExportProgressBar" 
                                     Height="20" 
                                     Minimum="0" 
                                     Maximum="100"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancel" 
                    Width="100" 
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#3F3F46" 
                    Foreground="White" 
                    BorderBrush="#555"
                    Click="Cancel_Click"/>
            <Button x:Name="ExportButton"
                    Content="Export" 
                    Width="100" 
                    Height="35"
                    Background="#0E639C" 
                    Foreground="White" 
                    BorderBrush="#0E639C"
                    Click="Export_Click"/>
        </StackPanel>
    </Grid>
</Window>